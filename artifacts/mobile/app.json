{
  "expo": {
    "name": "Deen o Dunya Planner",
    "slug": "mobile",
    "version": "1.3.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "07314f4d-5bc4-4bff-a00d-42ec6a54a8f7"
      },
      "apiOrigin": "https://deen-o-dunya-planner.replit.app"
    },
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.deenodunya.planner",
      "buildNumber": "19",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "audio",
          "fetch",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Your location is used to calculate accurate prayer times and find nearby mosques.",
        "NSLocationAlwaysUsageDescription": "Your location is used to calculate accurate prayer times.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.deenodunya.planner",
      "versionCode": 10,
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0A1628"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Deen o Dunya uses your photos when you choose an image from your photo library to create a Quran poster or personalized Islamic content to save and share."
        }
      ],
      [
        "expo-notifications",
        {
          "android": {
            "sounds": [
              "./assets/sounds/adhan.wav"
            ]
          },
          "ios": {
            "sounds": [
              "./assets/sounds/adhan.wav"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Deen o Dunya to access your location for prayer times and nearby masjids."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
